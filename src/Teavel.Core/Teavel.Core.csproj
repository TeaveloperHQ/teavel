<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Teavel</RootNamespace>
    <!-- Windows 전용 API는 Platform/ 뒤에 격리되어 있고 OperatingSystem.IsWindows() 로 가드된다.
         TFM 을 net8.0-windows 로 올리지 않는 이유: 리눅스에서 로직을 빌드·검증하기 위해. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>


  <!--
    scripts\ · catalog\ 를 exe 안에 묻는다.

    포털은 dotnet publish 결과에서 .exe 하나만 집어 배포한다 — 옆에 있던 폴더는 버려진다.
    그러면 교사가 받은 Teavel 은 PowerShell 모듈이 없어 아무것도 하지 못한다.
    묻어 두고 처음 쓸 때 꺼내 놓는다(Platform/Payload.cs).

    LogicalName 을 'Teavel.Payload.<폴더>.<파일>' 로 못 박는다 —
    기본 규칙은 폴더 이름을 점으로 잇고 파일 이름의 점까지 섞어 되짚기 어렵다.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\*.ps1;..\..\scripts\*.psm1">
      <LogicalName>Teavel.Payload.scripts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\catalog\*.json">
      <LogicalName>Teavel.Payload.catalog.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
